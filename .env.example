# App
APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ora?schema=public"
TOKEN_ENCRYPTION_KEY="base64:replace-with-32-byte-base64-key"

# WorkOS AuthKit
WORKOS_API_KEY="sk_example_123"
WORKOS_CLIENT_ID="client_example_123"
WORKOS_COOKIE_PASSWORD="replace-with-at-least-32-characters"
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"

# Shopify
SHOPIFY_API_VERSION="2026-04"

# Optional later OAuth path. The v1 Connections page uses per-store custom app
# API key/secret credentials, entered in the app and stored encrypted.
SHOPIFY_CLIENT_ID="replace-me"
SHOPIFY_CLIENT_SECRET="replace-me"
SHOPIFY_SCOPES="read_products,write_products,read_customers,read_orders"

# Connector chat agent
# Used only to choose and call connected read-only connector tools.
OPENAI_API_KEY="sk-proj_replace-me"
ORA_CHAT_MODEL="gpt-4.1-mini"
